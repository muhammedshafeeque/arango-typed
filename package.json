{
  "name": "arango-typed",
  "version": "1.6.0",
  "description": "TypeScript-first ArangoDB ORM/ODM/OGM with Mongoose-like API, multi-tenancy, vector search, and Express-friendly integration",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc --module esnext --outDir dist --declaration true && node scripts/fix-esm-extensions.js",
    "build:cjs": "tsc --module commonjs --outDir dist/cjs --declaration false --declarationMap false && node -e \"const fs=require('fs');fs.renameSync('dist/cjs/index.js','dist/index.cjs');fs.rmSync('dist/cjs',{recursive:true,force:true})\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "prepublishOnly": "npm run build && npm test",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "arangodb",
    "arango db",
    "arango",
    "orm",
    "odm",
    "ogm",
    "object-graph-mapper",
    "mongoose-like",
    "mongoose api",
    "typescript",
    "node",
    "nodejs",
    "express",
    "multi-tenancy",
    "multi tenant",
    "vector-search",
    "rag",
    "langchain",
    "graph-database",
    "graph",
    "edges",
    "vertices"
  ],
  "author": "Muhammed shafeeque P",
  "license": "MIT",
  "dependencies": {
    "arangojs": "^8.3.0"
  },
  "peerDependencies": {
    "@langchain/core": "^0.1.0 || ^1.0.0",
    "express": "^4.18.0",
    "fastify": "^4.0.0",
    "koa": "^2.14.0",
    "@nestjs/common": "^10.0.0",
    "next": "^14.0.0",
    "hono": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "koa": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhammedshafeeque/arango-typed.git"
  },
  "bugs": {
    "url": "https://github.com/muhammedshafeeque/arango-typed/issues"
  },
  "homepage": "https://github.com/muhammedshafeeque/arango-typed#readme"
}
